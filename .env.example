# =====================================================================
# Franzebi — variables de entorno (PLANTILLA SIN SECRETOS)
# Copiar a .env.local (desarrollo) o cargar en el panel del hosting (staging/producción).
# Detalle de cada variable: docs/05-variables-entorno.md
# =====================================================================

# --- Sitio ---
SITE_URL=http://localhost:3000
STAGING=true

# --- Supabase (proyecto del dueño) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# para CLI de sync fuera de Next:
SUPABASE_URL=

# --- Seguridad interna (generar con: openssl rand -base64 48) ---
CART_TOKEN_SECRET=
CRON_SECRET=

# --- Alegra (credencial de API; sólo en variables de entorno) ---
ALEGRA_API_EMAIL=
ALEGRA_API_TOKEN=
ALEGRA_RETAIL_PRICE_LIST="ARABES MINORISTA (pesos)"
ALEGRA_WHOLESALE_PRICE_LIST=MAYORISTA
# Doble llave: el sync sólo escribe si es "true" (aprobación explícita del dueño)
SYNC_ALLOW_APPLY=false

# --- Correo Argentino (MiCorreo) ---
CORREO_API_BASE=
CORREO_API_USER=
CORREO_API_PASSWORD=
CORREO_CUSTOMER_ID=
CORREO_ORIGIN_POSTCODE=

# --- Email transaccional (SMTP propio / proveedor) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Franzebi Imports <pedidos@franzebi.ar>"
ORDER_NOTIFY_TO=Franzebi.imports@gmail.com

# --- Datos operativos ---
# Texto multilínea con banco/CBU/alias (se muestra al cliente tras elegir transferencia)
BANK_TRANSFER_DETAILS=

# --- Pedidos hacia AstroSelling (D-18) ---
# URL del webhook de pedidos del canal actual y secreto compartido para la firma HMAC
ASTROSELLING_ORDER_WEBHOOK_URL=
ASTROSELLING_WEBHOOK_SECRET=
# Doble llave: en staging dejar false para no mandar pedidos de prueba a AstroSelling/Alegra
ORDER_DISPATCH_ENABLED=false

# --- E2E (sólo staging; usuarios de prueba, nunca reales) ---
E2E_BASE_URL=
LEGACY_BASE_URL=https://franzebi.ar
E2E_RETAIL_EMAIL=
E2E_RETAIL_PASSWORD=
E2E_WHOLESALE_EMAIL=
E2E_WHOLESALE_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_MAILPIT_URL=
